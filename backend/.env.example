# Copy this file to .env and fill in real values for your machine.
# Every variable here is actually read by the application — see src/config/env.js
# for the ones that are required at startup.

NODE_ENV=development
PORT=5000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lalaland_cafe
DB_USER=postgres
DB_PASSWORD=postgres

# JWT access token signing secret. Refresh tokens are NOT JWTs (they're opaque,
# random, hashed-at-rest tokens stored in the refresh_tokens table — see
# AuthService), so there is deliberately no JWT_REFRESH_SECRET here.
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m

# Allowed origin for CORS — should be your frontend's dev/prod URL
CORS_ORIGIN=http://localhost:3000

# Used to build the link in the (currently stubbed/logged) password-reset email
FRONTEND_URL=http://localhost:3000
